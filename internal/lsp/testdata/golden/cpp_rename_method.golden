[changed include/calc.h]
#pragma once

namespace shop {

// Calc accumulates a total.
class Calc {
public:
    int sum(int a, int b);

private:
    int total = 0;
};

}  // namespace shop
[changed src/calc.cpp]
#include "calc.h"

namespace shop {

// add adds a and b to the total.
int Calc::sum(int a, int b) {
    total += a + b;
    return total;
}

}  // namespace shop
[changed src/main.cpp]
#include "calc.h"

int main() {
    shop::Calc calc;
    int sum = calc.sum(1, 2);
    return calc.sum(sum, 3);
}
