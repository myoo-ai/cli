[changed calc/calc.go]
package calc

// Calc accumulates a total.
type Calc struct {
	total int
}

// Add adds x and b to the total and returns it.
func (c *Calc) Add(x, b int) int {
	c.total += x + b
	return c.total
}

// New returns an empty Calc.
func New() *Calc { return &Calc{} }
