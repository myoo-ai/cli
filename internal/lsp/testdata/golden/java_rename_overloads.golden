[changed com/shop/Calc.java]
package com.shop;

/** Accumulates a total. */
public class Calc {
    private int total;

    /** Adds {@code a} and {@code b} to the total. */
    public int sum(int a, int b) {
        total += a + b;
        return total;
    }

    public int sum(int a) {
        return sum(a, 0);
    }
}
[changed com/shop/Main.java]
package com.shop;

public class Main {
    public static void main(String[] args) {
        Calc calc = new Calc();
        System.out.println(calc.sum(1, 2) + calc.sum(3));
    }
}
