package com.shop;

/** Accumulates a total. */
public class Calc {
    private int total;

    /** Adds {@code x} and {@code b} to the total. */
    public int add(int x, int b) {
        total += x + b;
        return total;
    }

    public int add(int x) {
        return add(x, 0);
    }
}
